<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Low-level, internal P/Invoke layer over the CNA stable C ABI. Not intended
      for direct use by application code -- see CNA.Framework and CNA.XnaCompat.
    </Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable Condition="'$(CnaPackageAcceptance)' != 'true'">false</IsPackable>
  </PropertyGroup>

  <!-- The native asset is the installed CNA C API component (cmake install of the
       CNACApi component): libcna_c_api with RUNPATH $ORIGIN plus the SDL libraries CNA builds, which the
       loader then finds beside it. Packing the library alone, out of a build tree, produced a
       package that loaded only on the machine whose build tree its RUNPATH named. Only the soname
       files are packed (libSDL3.so.0, not its versioned target and unversioned link), because
       DT_NEEDED names the soname and a package has no symlinks. On macOS (CNA plans/plan_apple_m4.md
       AM4-221) the same holds for libcna_c_api.dylib, whose LC_RPATH is @loader_path: its
       LC_LOAD_DYLIB entries name libSDL3.0.dylib, libSDL3_image.0.dylib and libSDL3_mixer.0.dylib,
       so those names, read through their symlinks, are what is packed. Since CNA 89fb1493f a
       shared-runtime Linux build (CNA_SHARED_LIBRARY, ELF only) installs libcna.so beside it: the C
       adapter links CNA's one shared runtime instead of private copies of its modules, and its
       DT_NEEDED names libcna.so, an unversioned soname the lib*.so.? pattern does not match. -->
  <ItemGroup Condition="'$(CnaPackageAcceptance)' == 'true' and '$(CnaNativeDirectory)' != '' and '$(CnaNativeRid)' != ''">
    <CnaNativeAsset Include="$(CnaNativeDirectory)/libcna_c_api.so" Condition="Exists('$(CnaNativeDirectory)/libcna_c_api.so')" />
    <CnaNativeAsset Include="$(CnaNativeDirectory)/libcna.so" Condition="Exists('$(CnaNativeDirectory)/libcna.so')" />
    <CnaNativeAsset Include="$(CnaNativeDirectory)/libcna_c_api.dylib" Condition="Exists('$(CnaNativeDirectory)/libcna_c_api.dylib')" />
    <CnaNativeAsset Include="$(CnaNativeDirectory)/lib*.so.?;$(CnaNativeDirectory)/lib*.?.dylib;$(CnaNativeDirectory)/*.dll"
                    Exclude="$(CnaNativeDirectory)/lib*.?.?.?.dylib" />
    <None Include="@(CnaNativeAsset)"
          Pack="true"
          PackagePath="runtimes/$(CnaNativeRid)/native/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateCnaAcceptanceNativeAsset" BeforeTargets="Pack"
          Condition="'$(CnaPackageAcceptance)' == 'true' and ('$(CnaNativeDirectory)' != '' or '$(CnaNativeRid)' != '')">
    <Error Condition="'$(CnaNativeDirectory)' == '' or '$(CnaNativeRid)' == ''"
           Text="CnaNativeDirectory and CnaNativeRid must either both be set or both be empty." />
    <Error Condition="!Exists('$(CnaNativeDirectory)/libcna_c_api.so') and !Exists('$(CnaNativeDirectory)/libcna_c_api.dylib') and !Exists('$(CnaNativeDirectory)/cna_c_api.dll')"
           Text="CnaNativeDirectory='$(CnaNativeDirectory)' contains no CNA C API library; pass the lib directory of an installed CNACApi component." />
  </Target>

</Project>
