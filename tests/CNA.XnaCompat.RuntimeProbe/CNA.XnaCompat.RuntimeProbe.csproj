<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <CompatibilityTarget Condition="'$(CompatibilityTarget)' == ''">CNA</CompatibilityTarget>
    <TargetFramework Condition="'$(XnaWindowsSnapshot)' == 'true'">net48</TargetFramework>
    <PlatformTarget Condition="'$(XnaWindowsSnapshot)' == 'true'">x86</PlatformTarget>
    <Prefer32Bit Condition="'$(XnaWindowsSnapshot)' == 'true'">true</Prefer32Bit>
    <XnaReferencePath Condition="'$(XnaReferencePath)' == '' and '$(XNA_REFERENCE_PATH)' != ''">$(XNA_REFERENCE_PATH)</XnaReferencePath>
    <FnaFrameworkPath Condition="'$(FnaFrameworkPath)' == '' and '$(FNA_FRAMEWORK_PATH)' != ''">$(FNA_FRAMEWORK_PATH)</FnaFrameworkPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CompatibilityTarget)' == 'CNA'">
    <DefineConstants>$(DefineConstants);CNA_HOST_DRIVEN_FRAMES</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(CompatibilityTarget)' == 'CNA'">
    <ProjectReference Include="..\..\src\CNA.XnaCompat\CNA.XnaCompat.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CompatibilityTarget)' == 'XNA'">
    <Reference Include="Microsoft.Xna.Framework" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Xna.Framework.Game" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.Game.dll" Private="false" />
    <Reference Include="Microsoft.Xna.Framework.Graphics" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.Graphics.dll" Private="false" />
    <Reference Include="Microsoft.Xna.Framework.Storage" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.Storage.dll" Private="false" />
    <Reference Include="Microsoft.Xna.Framework.Video" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.Video.dll" Private="false" />
    <Reference Include="Microsoft.Xna.Framework.Xact" HintPath="$(XnaReferencePath)\Microsoft.Xna.Framework.Xact.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(CompatibilityTarget)' == 'FNA' and '$(FnaFrameworkPath)' != ''">
    <Reference Include="FNA" HintPath="$(FnaFrameworkPath)" Private="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(CompatibilityTarget)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

  <Target Name="ValidateCompatibilityReference" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CompatibilityTarget)' != 'CNA' and '$(CompatibilityTarget)' != 'XNA' and '$(CompatibilityTarget)' != 'FNA' and '$(CompatibilityTarget)' != 'MonoGame'"
           Text="Unknown CompatibilityTarget='$(CompatibilityTarget)'. Use CNA, XNA, FNA, or MonoGame." />
    <Error Condition="'$(CompatibilityTarget)' == 'XNA' and ('$(XnaReferencePath)' == '' or !Exists('$(XnaReferencePath)\Microsoft.Xna.Framework.dll'))"
           Text="Set XNA_REFERENCE_PATH or XnaReferencePath to the XNA 4.0 reference-assembly directory." />
    <Error Condition="'$(CompatibilityTarget)' == 'FNA' and ('$(FnaFrameworkPath)' == '' or !Exists('$(FnaFrameworkPath)'))"
           Text="Set FNA_FRAMEWORK_PATH or FnaFrameworkPath to FNA.dll." />
  </Target>

  <ItemGroup>
    <Compile Include="../probe-shared/ProbeOutput.cs" Link="ProbeOutput.cs" />
  </ItemGroup>

</Project>
